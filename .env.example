# Port for the Rust Axum Evaluator server
PORT=8080

# Logging level (trace, debug, info, warn, error)
RUST_LOG=info

# Google Gemini API key for automated test case generation
GEMINI_API_KEY=your_gemini_api_key_here

# AI Model to use (default: gemini-1.5-flash)
AI_MODEL=gemini-1.5-flash

# Path to wasi-sdk root directory (if installed locally outside Docker)
WASI_SDK_PATH=/opt/wasi-sdk

# Secret bearer token for Moodle plugin authentication (optional)
API_SECRET_KEY=
